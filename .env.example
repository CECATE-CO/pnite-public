# PNITE — modelo do .env (copie para .env e preencha; o .env NUNCA deve ser versionado)
SUPABASE_URL=
# Chave pública (pode ir para o navegador; só lê public.indicadores)
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (acesso total ao banco via /pg/query; apenas scripts administrativos)
SUPABASE_SECRET_KEY=

# Painel (Studio) e banco — uso administrativo
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=

S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Cargas
# Carga do SETE a enviar (AAAA-MM da extração; 2026-05 = maio/2026). Também pode ir em --carga.
CARGA_SETE=
# Ano do Censo Escolar pareado às cargas do SETE
ANO_CARGA_CENSO=2025
# Legado: usado só por --gerar-ddl (estrutura inicial)
ANO_CARGA_SETE=2026

# Autenticação (servidor Supabase auto-hospedado)
# Estas variáveis NÃO são lidas pela PNITE nem pelos scripts: devem ser copiadas para o .env do
# servidor (pasta do docker compose do Supabase) e aplicadas com: docker compose up -d auth
# Endereço principal da PNITE publicada (https://...). Também é o destino padrão dos links de e-mail.
SITE_URL=
# Outros endereços aceitos como retorno dos links (separados por vírgula, sem espaços).
# Inclua o endereço exato do PNITE.html (ex.: https://dominio/PNITE.html) e, para testes locais, http://localhost:PORTA/PNITE.html
ADDITIONAL_REDIRECT_URLS=
# Endereço público da API de autenticação (normalmente igual ao SUPABASE_URL)
API_EXTERNAL_URL=
# Modelos de e-mail do CECATE (pasta email/, publicada em https://pnite.vercel.app/email/).
# Também vão para o .env do SERVIDOR e precisam ser repassados ao serviço auth no docker-compose.yml.
GOTRUE_MAILER_TEMPLATES_RECOVERY=https://pnite.vercel.app/email/recuperacao.html
GOTRUE_MAILER_SUBJECTS_RECOVERY=PNITE — Redefinição de senha
GOTRUE_MAILER_TEMPLATES_CONFIRMATION=https://pnite.vercel.app/email/confirmacao.html
GOTRUE_MAILER_SUBJECTS_CONFIRMATION=PNITE — Confirme seu cadastro
GOTRUE_MAILER_TEMPLATES_INVITE=https://pnite.vercel.app/email/convite.html
GOTRUE_MAILER_SUBJECTS_INVITE=PNITE — Convite de acesso
# Intervalo mínimo entre e-mails para o mesmo endereço (padrão do Supabase: 60s). A PNITE mostra a contagem no botão.
GOTRUE_SMTP_MAX_FREQUENCY=10s
