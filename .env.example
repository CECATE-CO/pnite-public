# PNITE — modelo do .env (copie para .env e preencha; o .env NUNCA deve ser versionado)
SUPABASE_URL=
# Chave pública (pode ir para o navegador; só lê public.indicadores)
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (acesso total ao banco via /pg/query; apenas scripts administrativos)
SUPABASE_SECRET_KEY=

DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=

S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Anos de carga
ANO_CARGA_SETE=2026
ANO_CARGA_CENSO=2025
