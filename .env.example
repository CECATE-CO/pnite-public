# PNITE — modelo do .env (copie para .env e preencha; o .env NUNCA deve ser versionado)
SUPABASE_URL=
# Chave pública (pode ir para o navegador; só lê public.indicadores)
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (acesso total ao banco via /pg/query; apenas scripts administrativos)
SUPABASE_SECRET_KEY=

DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=

S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Cargas
# Carga do SETE a enviar (AAAA-MM da extração; 2026-05 = maio/2026). Também pode ir em --carga.
CARGA_SETE=
# Ano do Censo Escolar pareado às cargas do SETE
ANO_CARGA_CENSO=2025
# Legado: usado só por --gerar-ddl (estrutura inicial)
ANO_CARGA_SETE=2026
